export function useLanguage() {
  const [language, setLanguageState] = useState(() => {
    try {
      const savedLanguage = localStorage.getItem("proofbeforepay-language");

      if (["en", "hi", "kn"].includes(savedLanguage)) {
        return savedLanguage;
      }

      return "en";
    } catch {
      return "en";
    }
  });

  const setLanguage = (newLanguage) => {
    const safeLanguage = ["en", "hi", "kn"].includes(newLanguage)
      ? newLanguage
      : "en";

    setLanguageState(safeLanguage);

    try {
      localStorage.setItem("proofbeforepay-language", safeLanguage);
    } catch {
      // Language changes still work during the current session.
    }
  };

  const t = (key) => {
    return translations[language][key] ?? translations.en[key] ?? key;
  };

  return { language, setLanguage, t };
}
